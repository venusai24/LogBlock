; 4K random writes at queue depth 1 over 256M.
; Fixed size, not fixed time, so the log stays bounded (bench-output contract).
; direct=1 skips only the client page cache; no FLUSH is sent, so durability
; cost is not measured.
[randwrite-4k-qd1]
filename=/dev/nbd0
ioengine=libaio
direct=1
rw=randwrite
bs=4k
size=256M
iodepth=1
